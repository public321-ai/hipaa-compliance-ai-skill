{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHI Access Log",
  "type": "object",
  "required": ["log_id", "timestamp", "user_id", "system_id", "action"],
  "properties": {
    "log_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "user_id": {"type": "string"},
    "user_role": {"type": "string"},
    "system_id": {"type": "string"},
    "phi_record_id": {"type": "string", "description": "De-identified or hashed reference"},
    "action": {"type": "string", "enum": ["create", "read", "update", "delete", "export", "print", "share"]},
    "outcome": {"type": "string", "enum": ["success", "denied", "error"]},
    "ip_address": {"type": "string", "format": "ipv4"},
    "mfa_used": {"type": "boolean"},
    "anomaly_flags": {
      "type": "array",
      "items": {"type": "string", "enum": ["after_hours", "bulk_access", "unusual_location", "unauthorized_role", "no_mfa"]}
    }
  }
}