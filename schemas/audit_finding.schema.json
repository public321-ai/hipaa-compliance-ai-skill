{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Finding",
  "type": "object",
  "required": ["finding_id", "audit_date", "rule", "severity", "status"],
  "properties": {
    "finding_id": {"type": "string", "format": "uuid"},
    "audit_date": {"type": "string", "format": "date"},
    "rule": {
      "type": "object",
      "required": ["cfr_reference", "requirement"],
      "properties": {
        "cfr_reference": {"type": "string", "pattern": "^45 CFR 164\.[0-9]+$"},
        "requirement": {"type": "string"}
      }
    },
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "status": {"type": "string", "enum": ["open", "in_progress", "closed", "accepted_risk"]},
    "description": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "remediation": {
      "type": "object",
      "properties": {
        "action": {"type": "string"},
        "owner": {"type": "string"},
        "due_date": {"type": "string", "format": "date"},
        "completion_date": {"type": "string", "format": "date"},
        "verification": {"type": "string"}
      }
    }
  }
}